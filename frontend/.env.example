# Copy to .env. Expo SDK 54 inlines EXPO_PUBLIC_* vars at build/bundle time automatically.

# iOS simulator / web: http://localhost:4000 works as-is.
# Android emulator: use http://10.0.2.2:4000 instead (emulator's alias for the host machine).
# Physical device (Expo Go / dev build): use your machine's LAN IP, e.g. http://192.168.1.23:4000
#   — the phone can't resolve "localhost" to your dev machine.
EXPO_PUBLIC_API_URL=http://localhost:4000
