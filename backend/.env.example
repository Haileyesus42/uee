# Copy to .env and fill in for your environment.

NODE_ENV=development
PORT=4000

# Dedicated docker-compose Postgres (see docker-compose.yml) — deliberately NOT the
# machine's native Postgres on 5432, to avoid colliding with unrelated local projects.
DATABASE_URL="postgresql://compass:compass_dev_pw@localhost:5434/compass_dev?schema=public"

# Dedicated docker-compose Redis — deliberately NOT the machine's native Redis on 6379.
REDIS_URL="redis://localhost:6380"

# JWT signing secrets — generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Telegram bot login — the app's only auth method. Create a bot via @BotFather
# (/newbot), then set the token it gives you and the exact username you chose
# (no @, must end in "bot"). Login is disabled with a startup warning until both
# are set. Uses long-polling (getUpdates), not a webhook, so no public URL is
# needed even in production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Compass Pro billing. "mock" activates a subscription immediately with no real payment —
# use it for local dev. Swap to "chapa" in production once a live merchant key exists.
# Get CHAPA_SECRET_KEY from your Chapa dashboard (test key for sandbox, live key for
# production — console.chapa.co). PUBLIC_BASE_URL must be a real HTTPS URL Chapa's
# server can reach for the webhook (POST /billing/webhook/chapa) — in local dev, run
# this through a tunnel (e.g. `ngrok http 4000`) and set this to the tunnel's URL,
# since localhost is not reachable from Chapa's servers.
PAYMENT_PROVIDER=mock
CHAPA_SECRET_KEY=
PUBLIC_BASE_URL=

# Manual Telebirr payment: student sends money to this phone/name, uploads a
# screenshot of the confirmation, and a Groq vision call (GROQ_API_KEY below)
# reads the amount/reference/receiver off it. Exact amount match + receiver match
# + a never-seen-before screenshot auto-activates Pro; anything it can't be sure
# about is queued for manual review (POST /billing/telebirr/:id/review) instead of
# being auto-rejected, and pings ADMIN_TELEGRAM_CHAT_ID so you know to look.
# Leave blank to keep the Telebirr option hidden from the app.
TELEBIRR_RECEIVER_PHONE=
TELEBIRR_RECEIVER_NAME=

# Protects the Telebirr admin endpoints (review a submission / view its
# screenshot) — there's no separate admin login, just this shared secret. Generate
# one the same way as the JWT secrets above.
ADMIN_SECRET=
# Your personal Telegram chat id, so the bot can DM you when a Telebirr submission
# needs a manual look. Message your own bot once and read the chat id off the
# update (or ask @userinfobot). Leave blank to skip the notification.
ADMIN_TELEGRAM_CHAT_ID=

# Not used until the Phase 2 Unity chat module is built.
DEEPSEEK_API_KEY=

# Content ingestion only (backend/scripts/ingest/) — converts scanned past-paper and
# textbook page images into structured questions/lessons via a Groq vision model.
# Get a key at console.groq.com. GROQ_VISION_MODEL defaults to a known-vision-capable
# model as of when this was written — check console.groq.com/docs/models for the
# current vision-capable model id before a real ingestion run, since Groq's catalog
# changes over time. Not used by the running server, only by the ingest scripts.
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
