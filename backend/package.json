{
  "name": "compass-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "ingest:exam": "tsx scripts/ingest/extractExam.ts",
    "ingest:paper": "tsx scripts/ingest/extractPastPaper.ts",
    "ingest:lesson-text": "tsx scripts/ingest/extractLessonFromText.ts",
    "ingest:textbook": "tsx scripts/ingest/extractTextbookSections.ts",
    "ingest:lesson": "tsx scripts/ingest/extractLesson.ts",
    "ingest:import": "tsx scripts/ingest/importReviewed.ts",
    "ingest:download": "tsx scripts/ingest/downloadTextbooks.ts",
    "ingest:kehulum": "tsx scripts/ingest/convertKehulum.ts",
    "ingest:manifest": "tsx scripts/ingest/generateManifest.ts",
    "ingest:lesson-plan": "tsx scripts/ingest/manifestToLessonPlan.ts",
    "ingest:lesson-run": "tsx scripts/ingest/runLessonPlan.ts",
    "billing:expire": "tsx scripts/expireSubscriptions.ts",
    "explain:apply": "tsx scripts/explain/applyExplanations.ts",
    "explain:generate": "tsx scripts/explain/generateExplanations.ts",
    "explain:propagate": "tsx scripts/explain/propagateSiblings.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/client": "^5.22.0",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.11",
    "pino-pretty": "^11.2.2",
    "playwright": "^1.64.1",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
